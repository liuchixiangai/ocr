       <item row="15" column="1">
        <widget class="QDoubleSpinBox" name="doubleSpinBox_tcpMinInterval">
         <property name="toolTip">
          <string>The shortest time between two sends: the values that change meanwhile go out together, the latest ones</string>
         </property>
         <property name="suffix">
          <string notr="true"> s</string>
         </property>
         <property name="decimals">
          <number>2</number>
         </property>
         <property name="maximum">
