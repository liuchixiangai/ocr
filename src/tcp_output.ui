       <item row="16" column="1">
        <widget class="QDoubleSpinBox" name="doubleSpinBox_tcpRefresh">
         <property name="toolTip">
          <string>Send every value again this often, for a receiver that forgets them (a reloaded template, a restarted engine)</string>
         </property>
         <property name="suffix">
          <string notr="true"> s</string>
         </property>
         <property name="decimals">
          <number>1</number>
         </property>
         <property name="maximum">
          <double>3600.000000000000000</double>
